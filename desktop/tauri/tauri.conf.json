{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbyNode",
  "version": "0.0.1",
  "identifier": "dev.orbynode.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OrbyNode",
        "width": 1280,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:7676 ws://127.0.0.1:7676"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  }
}
